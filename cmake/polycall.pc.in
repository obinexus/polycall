prefix=${pcfiledir}/@PC_REL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: polycall
Description: Polycall program-first cross-language runtime (C library)
URL: https://github.com/obinexus/polycall
Version: @PROJECT_VERSION@
Cflags: -I${includedir}/polycall
Libs: -L${libdir} -l@PC_LIB_NAME@
Libs.private: @PC_LIBS_PRIVATE@

#!/usr/bin/make -f
# Debian packaging for polycall. Built by packaging/build-deb.sh, which
# copies this directory to debian/ in a clean export of the source tree.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export POLYCALL_TELEMETRY = off

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
	  -DPOLYCALL_INSTALL_SYSTEMD_UNIT=ON \
	  -DBUILD_TESTING=$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),OFF,ON)

# The suites that need the Go or Java toolchains (and the Go+Python NSIGII
# test) run in CI and tests/run_all.sh, not here: excluded by name. Every
# other suite must run; a skipped one (missing Build-Depends) fails the build.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cd obj-$(DEB_HOST_GNU_TYPE) && \
	  { ctest --output-on-failure \
	      -E '^polycall_(conformance_go|conformance_java|nsigii_two_process)$$' \
	      > ../ctest.log 2>&1 || { cat ../ctest.log; exit 1; }; } && \
	  cat ../ctest.log && \
	  if grep -q 'tests did not run' ../ctest.log; then echo "a test suite did not run" >&2; exit 1; fi
endif

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_makeshlibs:
	dh_makeshlibs -V 'libpolycall1 (>= 1.1.0)'
